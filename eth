Create a file apply-erethum-docs.ps1 in repo root with this content:

PowerShell
# apply-erethum-docs.ps1
Param(
  [string]$Branch = "docs/rename-erethum",
  [string]$CommitMsg = "docs: rename user-facing 'token(s)' -> 'erethum'"
)

Write-Host "Creating branch $Branch"
git fetch origin 2>$null
git checkout -b $Branch

# Get tracked files with extensions .md, .txt, .csv
$files = git ls-files '*.md' '*.txt' '*.csv' 2>$null
if (![string]::IsNullOrEmpty($files) -eq $false) {
  Write-Host "No markdown/text/csv files tracked in git to update."
  exit 1
}

$files = $files -split "`n" | ForEach-Object { $_.Trim() } | Where-Object { $_ -ne "" }

Write-Host "Files to be updated:"
$files | ForEach-Object { Write-Host "  $_" }

foreach ($f in $files) {
  $text = Get-Content -Raw -Encoding UTF8 $f
  $new = $text -replace '\bTOKEN\b','ERETHUM' `
                -replace '\bToken\b','Erethum' `
                -replace '\btokens\b','erethum' `
                -replace '\btoken\b','erethum'
  if ($new -ne $text) {
    # write backup
    Copy-Item -Force $f "$f.bak"
    Set-Content -Encoding UTF8 -NoNewline $f $new
    Write-Host "Updated: $f"
  }
}

Write-Host "`nReview changes (git status):"
git --no-pager diff --name-only

git add -A
git commit -m $CommitMsg

Write-Host "`nDone. Branch: $Branch"
Write-Host "Next steps:`n  git push -u origin $Branch`n  Open a PR from $Branch -> main, review, then merge."
