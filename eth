// evaluate-token.js
// Usage: RPC_URL must be in env. Run: node evaluate-token.js <tokenAddress>
// Example: RPC_URL="https://eth-mainnet.g.alchemy.com/v2/..." node evaluate-token.js 0xYourTokenAddress

require("dotenv").config();
const { ethers } = require("ethers");

if (process.argv.length < 3) {
  console.error("Usage: node evaluate-token.js <tokenAddress>");
  process.exit(1);
}

const TOKEN = process.argv[2];
const RPC = process.env.RPC_URL || process.env.ALCHEMY_URL;
if (!RPC) {
  console.error("Set RPC_URL or ALCHEMY_URL in .env");
  process.exit(1);
}

const provider = new ethers.providers.JsonRpcProvider(RPC);

// Common addresses on Ethereum mainnet (change for other chains)
const UNISWAP_V2_FACTORY = "0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f";
const UNISWAP_V2_PAIR_ABI = [
  "function getReserves() view returns (uint112,uint112,uint32)",
  "function token0() view returns (address)",
  "function token1() view returns (address)"
];
const UNISWAP_V2_FACTORY_ABI = [
  "function getPair(address tokenA, address tokenB) view returns (address pair)"
];

const ERC20_ABI = [
  "function decimals() view returns (uint8)",
  "function symbol() view returns (string)",
  "function totalSupply() view returns (uint256)",
  "function balanceOf(address) view returns (uint256)"
];

// Common quote tokens (mainnet). For other networks swap addresses accordingly.
const QUOTE_TOKENS = {
  USDC: "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eb48",
  USDT: "0xdAC17F958D2ee523a2206206994597C13D831ec7",
  WETH: "0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2",
  DAI:  "0x6B175474E89094C44Da98b954EedeAC495271d0F"
};

async function main() {
  const tokenAddr = ethers.utils.getAddress(TOKEN);
  const token = new ethers.Contract(tokenAddr, ERC20_ABI, provider);

  const [decimals, symbol, totalSupply] = await Promise.all([
    token.decimals().catch(() => 18),
    token.symbol().catch(() => "TKN"),
    token.totalSupply().catch(() => ethers.BigNumber.from(0))
  ]);

  console.log(`Token: ${symbol} (${tokenAddr}) decimals=${decimals}`);
  console.log(`Total supply (raw) = ${totalSupply.toString()}`);

  const factory = new ethers.Contract(UNISWAP_V2_FACTORY, UNISWAP_V2_FACTORY_ABI, provider);

  // For each quote token, check if a pair exists and if so read reserves
  const pools = [];

  for (const [name, addr] of Object.entries(QUOTE_TOKENS)) {
    const pairAddr = await factory.getPair(tokenAddr, addr);
    if (pairAddr && pairAddr !== ethers.constants.AddressZero) {
      try {
        const pair = new ethers.Contract(pairAddr, UNISWAP_V2_PAIR_ABI, provider);
        const [reserve0, reserve1] = await pair.getReserves();
        const token0 = await pair.token0();
        const token1 = await pair.token1();

        // Determine which reserve is token and which is quote
        let reserveToken, reserveQuote;
        if (token0.toLowerCase() === tokenAddr.toLowerCase()) {
          reserveToken = reserve0;
          reserveQuote = reserve1;
        } else {
          reserveToken = reserve1;
          reserveQuote = reserve0;
        }

        pools.push({
          pair: pairAddr,
          quote: name,
          quoteAddress: addr,
          reserveToken: ethers.BigNumber.from(reserveToken.toString()),
          reserveQuote: ethers.BigNumber.from(reserveQuote.toString())
        });

        console.log(`Found pool vs ${name}: pair=${pairAddr}`);
      } catch (e) {
        console.warn(`Failed to read pair ${pairAddr}:`, e.message);
      }
    } else {
      console.log(`No pair found vs ${name}`);
    }
  }

  if (pools.length === 0) {
    console.log("No Uniswap V2-style pools found vs the common quotes. Provide pair addresses or check other DEXes.");
    return;
  }

  // Helper: compute token price in quote units (quote per token)
  function priceFromReserves(reserveToken, reserveQuote, tokenDecimals=decimals, quoteDecimals=6) {
    // price = (reserveQuote / 10^quoteDecimals) / (reserveToken / 10^tokenDecimals)
    const rQ = Number(ethers.utils.formatUnits(reserveQuote, quoteDecimals));
    const rT = Number(ethers.utils.formatUnits(reserveToken, tokenDecimals));
    if (rT === 0) return 0;
    return rQ / rT;
  }

  // For each pool: compute spot price, USD liquidity (if quote is USD), and simulate slippage for trade sizes
  let aggregateNumerator = 0; // price * usdLiquidity
  let aggregateDenominator = 0; // usdLiquidity

  for (const p of pools) {
    // determine quote decimals (rough defaults)
    const qDecimals = (p.quote === "USDC" || p.quote === "USDT") ? 6 : (p.quote === "DAI" ? 18 : 18);
    const spotPrice = priceFromReserves(p.reserveToken, p.reserveQuote, decimals, qDecimals);
    // compute USD liquidity estimate:
    let usdLiquidity = 0;
    if (p.quote === "USDC" || p.quote === "USDT" || p.quote === "DAI") {
      // USD-based quote: USD liquidity in pool = reserveQuote (in human) * 2? Actually pool has both assets; USD liquidity approximated by reserveQuote * 2 (both sides combined)
      const reserveQuoteHuman = Number(ethers.utils.formatUnits(p.reserveQuote, qDecimals));
      usdLiquidity = reserveQuoteHuman * 2;
    } else if (p.quote === "WETH") {
      // For WETH we need WETH price in USD; not available here. We'll treat WETH liquidity separately.
      usdLiquidity = 0;
    }

    console.log(`Pool ${p.pair} vs ${p.quote}: spotPrice = ${spotPrice} ${p.quote}/${symbol}, USD liquidity ≈ ${usdLiquidity}`);

    // Simulate price impact for a set of buy sizes (token units)
    const sizes = [0.1, 1, 10, 100, 1000]; // in quote or token? We'll simulate buying tokens using quote (e.g., USD)
    // We'll simulate swapping quote -> token (buying token) with UniswapV2 formula: amountOut = amountInWithFee * reserveOut / (reserveIn + amountInWithFee)
    // Here reserveIn = reserveQuote, reserveOut = reserveToken, amountIn is in quote units (in quote token's decimals)
    function quoteToTokenAmountOut(amountInHuman) {
      // convert human quote to raw
      const amountIn = ethers.utils.parseUnits(amountInHuman.toString(), qDecimals);
      const reserveIn = p.reserveQuote;
      const reserveOut = p.reserveToken;
      // fee 0.3% -> 997/1000
      const amountInWithFee = amountIn.mul(997);
      const numerator = amountInWithFee.mul(reserveOut);
      const denominator = reserveIn.mul(1000).add(amountInWithFee);
      const amountOut = numerator.div(denominator);
      return Number(ethers.utils.formatUnits(amountOut, decimals));
    }

    // For a few buy amounts in quote (USD), show price impact
    const buyUsdSamples = [1, 10, 100, 1000, 10000]; // USD
    console.log(" buyUsd -> tokens_out  | effective price (USD per token) | price impact vs spot");
    for (const usd of buyUsdSamples) {
      if (p.quote === "USDC" || p.quote === "USDT" || p.quote === "DAI") {
        const tokensOut = quoteToTokenAmountOut(usd);
        if (tokensOut === 0) continue;
        const effectivePrice = usd / tokensOut;
        const priceImpact = (effectivePrice - spotPrice) / spotPrice;
        console.log(`  $${usd} -> ${tokensOut.toFixed(6)} ${symbol} | $${effectivePrice.toFixed(6)} | ${(priceImpact*100).toFixed(3)}%`);
      }
    }

    // aggregate weighted price by USD liquidity
    if (usdLiquidity > 0) {
      aggregateNumerator += spotPrice * usdLiquidity;
      aggregateDenominator += usdLiquidity;
    }
  }

  const aggregatedPrice = aggregateDenominator > 0 ? (aggregateNumerator / aggregateDenominator) : null;
  if (aggregatedPrice) {
    // compute market cap using totalSupply (convert totalSupply to human)
    const supplyHuman = Number(ethers.utils.formatUnits(totalSupply, decimals));
    const marketCap = supplyHuman * aggregatedPrice;
    console.log(`\nAggregated price (USD) across USD pools: $${aggregatedPrice}`);
    console.log(`Circulating supply (approx) = ${supplyHuman}`);
    console.log(`Estimated market cap = $${marketCap.toLocaleString(undefined, {maximumFractionDigits:2})}`);
  } else {
    console.log("Could not aggregate USD price (no USD-quoted pools found).");
  }

  console.log("\nDone.");
}

main().catch((e) => {
  console.error("Error:", e);
});
Notes & assumptions

This script uses Uniswap V2 formula (constant product) and 0.3% fee. Many DEXes use similar math (SushiSwap, PancakeSwap), but Uniswap V3 uses concentrated liquidity and a different approach.
For WETH-quoted pools you need a WETH→USD price (from an oracle or a stablecoin pool) to convert to USD.
For multiple pools, I weight prices by USD liquidity in the pool (reserveQuote in USD * 2 approximation) — this gives a liquidity‑weighted average price.
Circulating supply vs totalSupply: token.totalSupply may be total minted; circulating supply might exclude treasury/team holdings. You may need to read treasury addresses and subtract. The script uses on-chain totalSupply as a starting point.
Slippage and price impact are simulated for a single swap. Real orders hitting orderbooks or router pathing and DEX aggregators (1inch, 0x) will split orders across pools to minimize impact.
For Uniswap V3, price and liquidity are in slot0 and tick/positions; I can add V3 code if needed.
