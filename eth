JavaScript
// encrypt_price.js
// Usage example:
//   node encrypt_price.js --price 0.12345 --token 0xABC... --network mainnet --note "snapshot 2026-08-08"
//
// Outputs:
//  - Encrypted payload (base64 JSON) and data URL
//  - Key (hex) that must be shared separately

const crypto = require("crypto");
const argv = require("minimist")(process.argv.slice(2));

if (!argv.price || !argv.token) {
  console.error("Usage: node encrypt_price.js --price <price> --token <tokenAddress> [--network mainnet] [--note 'text']");
  process.exit(1);
}

const price = argv.price.toString();
const token = argv.token;
const network = argv.network || "mainnet";
const note = argv.note || "";

function genKey() {
  return crypto.randomBytes(32); // 256-bit key
}

function encryptJSON(key, obj) {
  const iv = crypto.randomBytes(12); // 96-bit IV recommended for GCM
  const cipher = crypto.createCipheriv("aes-256-gcm", key, iv, { authTagLength: 16 });
  const plaintext = Buffer.from(JSON.stringify(obj), "utf8");
  const ct = Buffer.concat([cipher.update(plaintext), cipher.final()]);
  const tag = cipher.getAuthTag();
  return {
    iv: iv.toString("base64"),
    tag: tag.toString("base64"),
    ct: ct.toString("base64")
  };
}

function main() {
  const key = genKey();
  const keyHex = key.toString("hex");
  const payload = {
    token,
    network,
    price,
    timestamp: new Date().toISOString(),
    note
  };
  const encrypted = encryptJSON(key, payload);
  const envelope = {
    alg: "AES-256-GCM",
    payload: encrypted
  };
  const envelopeJson = JSON.stringify(envelope);
  const envelopeB64 = Buffer.from(envelopeJson, "utf8").toString("base64");

  // Create a data URL that contains the ciphertext (safe to share) but not the key.
  const dataUrl = "data:application/octet-stream;base64," + envelopeB64;

  console.log("=== ENCRYPTED PAYLOAD ===");
  console.log(envelopeB64);
  console.log("");
  console.log("=== DATA URL (share this) ===");
  console.log(dataUrl);
  console.log("");
  console.log("=== SECRET KEY (share securely!) ===");
  console.log(keyHex);
  console.log("");
  console.log("How to decrypt:");
  console.log(" - Use the provided decrypt_and_multiply.html page and provide the Data URL and the hex key.");
  console.log(" - Or run a decrypt script that performs AES-256-GCM with the given iv/tag/ct and key.");
  console.log("");
  console.log("Note: Keep the secret key secret. The data URL only contains ciphertext.");
}

