function parseArgs() {
  const argv = process.argv.slice(2);
  if (argv.length < 1) {
    console.error("Usage: dex-price.js <tokenAddress> [--chain id] [--twap seconds] [--trade amount] [--account addr]");
    process.exit(1);
  }
  const token = argv[0];
  const opts = { chain: 1, twap: 3600, trade: null, account: null };
  for (let i = 1; i < argv.length; i++) {
    if (argv[i] === "--chain") opts.chain = Number(argv[++i]);
    else if (argv[i] === "--twap") opts.twap = Number(argv[++i]);
    else if (argv[i] === "--trade") opts.trade = argv[++i];
    else if (argv[i] === "--account") opts.account = argv[++i];
    else {
      console.warn("Unknown arg", argv[i]);
    }
  }
  return { token, opts };
}

// helper to compute price from Uniswap V3 sqrtPriceX96
function v3SqrtPriceX96ToPrice(sqrtPriceX96, decimals0 = 18, decimals1 = 18) {
  // price = (sqrtPriceX96 / 2^96)^2
  // then adjust decimals: price_human = price * 10^(decimals0 - decimals1)
  const Q96 = ethers.BigNumber.from(2).pow(96);
  // Use JS numbers for float math — convert to Number with caution; pool prices typically in reasonable ranges.
  const sqrtPrice = Number(sqrtPriceX96.toString()) / Number(Q96.toString());
  const price = sqrtPrice * sqrtPrice;
  const adj = Math.pow(10, decimals0 - decimals1);
  return price * adj;
}

// tick -> price (token1 per token0), using 1.0001^tick
function tickToPrice(tick, decimals0 = 18, decimals1 = 18) {
  const price = Math.pow(1.0001, tick);
  return price * Math.pow(10, decimals0 - decimals1);
}

async function coinGeckoEthUsd() {
  try {
    const res = await fetch("https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd");
    if (!res.ok) return null;
    const j = await res.json();
    return j.ethereum && j.ethereum.usd ? j.ethereum.usd : null;
  } catch (e) {
    return null;
  }
}

// Uniswap V2 constant product swap output for exact input (with 0.3% fee)
function getAmountOutV2(amountInRaw, reserveInRaw, reserveOutRaw, feeNumerator = 997, feeDenominator = 1000) {
  // amountInWithFee = amountInRaw * feeNumerator / feeDenominator
  // amountOut = (amountInWithFee * reserveOut) / (reserveIn + amountInWithFee)
  const amountInWithFee = amountInRaw * (feeNumerator / feeDenominator);
  return (amountInWithFee * reserveOutRaw) / (reserveInRaw + amountInWithFee);
}

