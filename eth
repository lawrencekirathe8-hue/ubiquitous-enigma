require('dotenv').config();
const { ethers } = require('ethers');
const fetch = require('node-fetch'); // v2 works well: npm i node-fetch@2
const HttpsProxyAgent = require('https-proxy-agent'); // npm i https-proxy-agent

const PROXY = process.env.PROXY || process.env.HTTPS_PROXY || process.env.HTTP_PROXY || null;
const RPC = process.env.RPC_URL || process.env.ALCHEMY_URL || 'https://cloudflare-eth.com';
const TIMEOUT_MS = parseInt(process.env.RPC_TIMEOUT_MS || '15000', 10);
const RETRIES = parseInt(process.env.RPC_RETRIES || '2', 10);

if (process.argv.length < 3) {
  console.error("Usage: node evaluate-token-proxy.js <tokenAddress>");
  process.exit(1);
}
const TOKEN = process.argv[2];

function makeFetchWithProxy() {
  // ethers allows passing a custom fetch(url, options) => Promise<Response>
  // We wrap node-fetch and attach a proxy agent when PROXY is set.
  if (!PROXY) {
    return async (url, options) => {
      // simple timeout wrapper
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), TIMEOUT_MS);
      try {
        const resp = await fetch(url, { ...options, signal: controller.signal });
        return resp;
      } finally {
        clearTimeout(timeout);
      }
    };
  }

  const agent = new HttpsProxyAgent(PROXY);
  return async (url, options) => {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      // pass the proxy agent to node-fetch via `agent`
      const resp = await fetch(url, { ...options, agent, signal: controller.signal });
      return resp;
    } finally {
      clearTimeout(timeout);
    }
  };
}

function makeProvider(rpcUrl) {
  // Create ethers JsonRpcProvider with custom fetch to honor proxy/timeouts
  const customFetch = makeFetchWithProxy();
  // ethers.providers.JsonRpcProvider accepts an object with url and fetch in v5:
  return new ethers.providers.JsonRpcProvider({ url: rpcUrl, fetch: customFetch });
}

async function withRetries(fn, retries = RETRIES) {
  let lastErr;
  for (let i = 0; i <= retries; i++) {
    try {
      return await fn();
    } catch (err) {
      lastErr = err;
      // small backoff
      await new Promise((r) => setTimeout(r, 500 * (i + 1)));
    }
  }
  throw lastErr;
}

