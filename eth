Below is a ready-to-run Node.js script that checks an address's ERETHUM balance and computes its USD value by combining on‑chain pair reserves (Uniswap V2-style) with an ETH→USD price from CoinGecko. It falls back to a 1inch quote if no suitable pair is found.

Save as value-of-erethum.js in your repo, install dependencies (ethers + node-fetch), and run as shown.

Script (value-of-erethum.js)

JavaScript
#!/usr/bin/env node
// value-of-erethum.js
// Usage:
//   RPC_URL=<rpc> node value-of-erethum.js <tokenAddress> <accountAddress> [chainId]
// Example:
//   RPC_URL=https://mainnet.infura.io/v3/KEY node value-of-erethum.js 0x9A9C... 0xYourAddr 1

const { ethers } = require("ethers");
const fetch = require("node-fetch");

async function main() {
  const args = process.argv.slice(2);
  if (args.length < 2) {
    console.error("Usage: node value-of-erethum.js <tokenAddress> <accountAddress> [chainId]");
    process.exit(1);
  }
  const [tokenAddress, account, chainIdArg] = args;
  const RPC = process.env.RPC_URL;
  if (!RPC) {
    console.error("Set RPC_URL environment variable to an Ethereum JSON-RPC endpoint.");
    process.exit(1);
  }
  const chainId = chainIdArg ? Number(chainIdArg) : 1;

  const provider = new ethers.providers.JsonRpcProvider(RPC);
  const tokenAbi = [
    "function balanceOf(address) view returns (uint256)",
    "function decimals() view returns (uint8)",
    "function symbol() view returns (string)",
    "function name() view returns (string)"
  ];
  const token = new ethers.Contract(tokenAddress, tokenAbi, provider);

  // Uniswap V2 factory/router constants (mainnet). If chainId is different, these may need updating.
  const UNISWAP_V2_FACTORY = {
    1: "0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f" // mainnet
  }[chainId];
  const WETH = {
    1: "0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2" // mainnet WETH
  }[chainId];
  const USDC = {
    1: "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eb48"
  }[chainId];

  // Basic ABIs
  const factoryAbi = ["function getPair(address, address) external view returns (address)"];
  const pairAbi = [
    "function getReserves() view returns (uint112 reserve0, uint112 reserve1, uint32 blockTimestampLast)",
    "function token0() view returns (address)",
    "function token1() view returns (address)"
  ];

  // 1) Read token basic info and user balance
  const [decimals, symbol, name, rawBalance] = await Promise.all([
    token.decimals().catch(() => 18),
    token.symbol().catch(() => "ERETHUM"),
    token.name().catch(() => "Erethum"),
    token.balanceOf(account)
  ]);
  const balanceHuman = parseFloat(ethers.utils.formatUnits(rawBalance, decimals));

  // Helper: format big numbers to float strings
  const format = (bn, d = 18) => parseFloat(ethers.utils.formatUnits(bn, d));

  // 2) Try to get price via Uniswap V2 pair token <> WETH
  let pricePerTokenInEth = null;
  try {
    if (!UNISWAP_V2_FACTORY || !WETH) throw new Error("No factory/WETH configured for this chainId.");
    const factory = new ethers.Contract(UNISWAP_V2_FACTORY, factoryAbi, provider);
    const pairAddr = await factory.getPair(tokenAddress, WETH);
    if (pairAddr && pairAddr !== ethers.constants.AddressZero) {
      const pair = new ethers.Contract(pairAddr, pairAbi, provider);
      const [token0, token1] = await Promise.all([pair.token0(), pair.token1()]);
      const reserves = await pair.getReserves();
      // reserve0 corresponds to token0, reserve1 to token1
      let reserveToken, reserveWeth;
      if (token0.toLowerCase() === tokenAddress.toLowerCase()) {
        reserveToken = reserves.reserve0;
        reserveWeth = reserves.reserve1;
      } else {
        reserveToken = reserves.reserve1;
        reserveWeth = reserves.reserve0;
      }
      // price in ETH = (reserveWeth/1e18) / (reserveToken/10^decimals)
      const reserveWethFloat = format(reserveWeth, 18);
      const reserveTokenFloat = format(reserveToken, decimals);
      pricePerTokenInEth = reserveWethFloat / reserveTokenFloat;
      // console.log("DEBUG (pair):", { pairAddr, reserveTokenFloat, reserveWethFloat, pricePerTokenInEth });
    }
  } catch (err) {
    // ignore and fallback
  }

  // 3) If no token<>WETH pair, try token<>USDC and compute price in USD directly
  let pricePerTokenInUsd = null;
  try {
    if (!pricePerTokenInEth && USDC) {
      const factory = new ethers.Contract(UNISWAP_V2_FACTORY, factoryAbi, provider);
      const pairAddr = await factory.getPair(tokenAddress, USDC);
      if (pairAddr && pairAddr !== ethers.constants.AddressZero) {
        const pair = new ethers.Contract(pairAddr, pairAbi, provider);
        const [token0, token1] = await Promise.all([pair.token0(), pair.token1()]);
        const reserves = await pair.getReserves();
        let reserveToken, reserveUsdc;
        if (token0.toLowerCase() === tokenAddress.toLowerCase()) {
          reserveToken = reserves.reserve0;
          reserveUsdc = reserves.reserve1;
        } else {
          reserveToken = reserves.reserve1;
          reserveUsdc = reserves.reserve0;
        }
        const reserveUsdcFloat = parseFloat(ethers.utils.formatUnits(reserveUsdc, 6)); // USDC 6 decimals
        const reserveTokenFloat = format(reserveToken, decimals);
        pricePerTokenInUsd = reserveUsdcFloat / reserveTokenFloat;
      }
    }
  } catch (err) {
    // ignore
  }

  // 4) Fallback: ask 1inch public API for a quote of 1 token -> USDC (chainId-aware)
  if (pricePerTokenInUsd === null && pricePerTokenInEth === null) {
    try {
      // Get per-token amount in smallest units
      const oneTokenAmount = ethers.utils.parseUnits("1", decimals).toString();
      const CHAIN = chainId; // 1 = mainnet
      const toToken = USDC; // current fallback to USDC
      const url = `https://api.1inch.io/v5.0/${CHAIN}/quote?fromTokenAddress=${tokenAddress}&toTokenAddress=${toToken}&amount=${oneTokenAmount}`;
      const res = await fetch(url);
      if (res.ok) {
        const j = await res.json();
        // j.toTokenAmount is in USDC smallest units
        if (j && j.toTokenAmount) {
          const usdcAmount = j.toTokenAmount; // string
          pricePerTokenInUsd = parseFloat(ethers.utils.formatUnits(usdcAmount, 6)); // USDC 6 decimals
        }
      } else {
        // ignore
      }
    } catch (err) {
      // ignore
    }
  }

  // 5) If we have price in ETH but not USD, get ETH->USD via CoinGecko
  if (pricePerTokenInUsd === null && pricePerTokenInEth !== null) {
    try {
      // CoinGecko: simple price for ethereum in usd
      const cg = await fetch("https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd");
      const js = await cg.json();
      const ethInUsd = js && js.ethereum && js.ethereum.usd ? js.ethereum.usd : null;
      if (ethInUsd) {
        pricePerTokenInUsd = pricePerTokenInEth * ethInUsd;
      }
    } catch (err) {
      // ignore
    }
  }

  // 6) If we have pricePerTokenInUsd, compute totals, else report inability
  console.log(`\nErethum contract: ${tokenAddress}`);
  console.log(`Account: ${account}`);
  console.log(`Token: ${name} (${symbol}), decimals: ${decimals}`);
  console.log(`Balance: ${balanceHuman} ${symbol}`);

  if (pricePerTokenInEth !== null) {
    console.log(`Price per ${symbol}: ${pricePerTokenInEth} ETH`);
  }
  if (pricePerTokenInUsd !== null) {
    const totalUsd = pricePerTokenInUsd * balanceHuman;
    console.log(`Price per ${symbol}: $${pricePerTokenInUsd.toLocaleString(undefined, {maximumFractionDigits: 8})} USD`);
    console.log(`Total value: $${totalUsd.toLocaleString(undefined, {maximumFractionDigits: 2})} USD`);
  } else {
    console.log("Unable to determine USD price for this token via on-chain pairs or 1inch. Try ensuring there is liquidity or use a trusted price oracle.");
  }

  console.log(""); // newline
}

main().catch((err) => {
  console.error("Error:", err);
  process.exit(1);
});
