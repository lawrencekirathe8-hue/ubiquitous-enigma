  const price = sqrtPrice * sqrtPrice;
  const adj = Math.pow(10, decimals0 - decimals1);
  return price * adj;
}

function tickToPrice(tick, decimals0 = 18, decimals1 = 18) {
  const price = Math.pow(1.0001, tick);
  return price * Math.pow(10, decimals0 - decimals1);
}

