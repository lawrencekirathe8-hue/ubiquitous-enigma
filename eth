// server-host-example.js (educational only)
const express = require("express");
const fs = require("fs");
const app = express();
app.use(express.json());

// naive in-memory store (for demo only)
const store = {}; // id -> { envelopeB64, keyHex }

app.post("/store", (req, res) => {
  const { envelopeB64, keyHex } = req.body;
  const id = Math.random().toString(36).slice(2,10);
  store[id] = { envelopeB64, keyHex };
  // In production store keyHex in a KMS and return only access metadata
  res.json({ id, url: `https://your-server.example/payload/${id}` });
});

app.get("/payload/:id", (req, res) => {
  const rec = store[req.params.id];
  if (!rec) return res.status(404).send("not found");
  // Do NOT send key here. Only send envelope and require key from user separately.
  res.json({ envelopeB64: rec.envelopeB64 });
});

app.get("/fetch-key/:id", (req, res) => {
  // This endpoint would require additional authentication & auditing
  const rec = store[req.params.id];
  if (!rec) return res.status(404).send("not found");
  res.json({ keyHex: rec.keyHex });
});

