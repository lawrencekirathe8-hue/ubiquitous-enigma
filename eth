    if (usdLiquidity > 0) {
      aggregateNumerator += spotPrice * usdLiquidity;
      aggregateDenominator += usdLiquidity;
    }
  }

  const aggregatedPrice = aggregateDenominator > 0 ? (aggregateNumerator / aggregateDenominator) : null;
  if (aggregatedPrice) {
    const supplyHuman = Number(ethers.utils.formatUnits(totalSupply, decimals));
    const marketCap = supplyHuman * aggregatedPrice;
    console.log(`\nAggregated price (USD) across USD pools: $${aggregatedPrice}`);
    console.log(`Circulating supply (approx) = ${supplyHuman}`);
    console.log(`Estimated market cap = $${marketCap.toLocaleString(undefined, {maximumFractionDigits:2})}`);
  } else {
    console.log("Could not aggregate USD price (no USD-quoted pools found).");
  }

  console.log("\nDone.");
}

main().catch((e) => {
  console.error("Fatal error:", e.message || e);
  process.exit(1);
});
