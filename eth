      const reserveToken = t0.toLowerCase() === tokenAddr.toLowerCase() ? r0 : r1;
      const reserveQuote = t0.toLowerCase() === tokenAddr.toLowerCase() ? r1 : r0;
      pools.push({ pair: pairAddr, quote: name, quoteAddress: addr, reserveToken, reserveQuote });
      console.log(`Found pool vs ${name}: ${pairAddr}`);
    } else {
      console.log(`No pair vs ${name}`);
    }
  }

  if (pools.length === 0) { console.log("No V2 pools found vs common quotes."); return; }

  function priceFromReserves(reserveToken, reserveQuote, tokenDec, quoteDec) {
    const rQ = Number(ethers.utils.formatUnits(reserveQuote, quoteDec));
    const rT = Number(ethers.utils.formatUnits(reserveToken, tokenDec));
    return rT === 0 ? 0 : rQ / rT;
  }

  let aggNum = 0, aggDen = 0;
  for (const p of pools) {
    const qdec = (p.quote==="USDC"||p.quote==="USDT")?6:(p.quote==="DAI"?18:18);
    const spot = priceFromReserves(p.reserveToken, p.reserveQuote, decimals, qdec);
    let usdLiquidity = 0;
    if (p.quote==="USDC"||p.quote==="USDT"||p.quote==="DAI") {
      const rQHuman = Number(ethers.utils.formatUnits(p.reserveQuote, qdec));
      usdLiquidity = rQHuman * 2;
    }
    console.log(`Pool ${p.pair} vs ${p.quote}: spot=${spot} ${p.quote}/${symbol}, USD liquidity≈${usdLiquidity}`);
    const buySamples=[1,10,100,1000,10000];
    function quoteToTokenOut(amt) {
      const amountIn = ethers.utils.parseUnits(amt.toString(), qdec);
      const reserveIn = p.reserveQuote;
      const reserveOut = p.reserveToken;
      const amountInWithFee = amountIn.mul(997);
      const num = amountInWithFee.mul(reserveOut);
      const den = reserveIn.mul(1000).add(amountInWithFee);
      const amtOut = num.div(den);
      return Number(ethers.utils.formatUnits(amtOut, decimals));
    }
    console.log(" buyUSD -> tokens_out | effective $/token | impact%");
    for (const usd of buySamples) {
      if (usdLiquidity>0) {
        const tokensOut = quoteToTokenOut(usd);
        if (tokensOut===0) continue;
        const eff = usd / tokensOut;
        const impact = ((eff - spot)/spot)*100;
        console.log(`  $${usd} -> ${tokensOut.toFixed(6)} ${symbol} | $${eff.toFixed(6)} | ${impact.toFixed(3)}%`);
      }
    }
    if (usdLiquidity>0) { aggNum += spot * usdLiquidity; aggDen += usdLiquidity; }
  }

  if (aggDen>0) {
    const agg = aggNum/aggDen;
    const supplyHuman = Number(ethers.utils.formatUnits(totalSupply, decimals));
    const mcap = supplyHuman * agg;
    console.log(`\nAggregated price (USD): $${agg}`);
    console.log(`Estimated market cap: $${mcap.toLocaleString(undefined,{maximumFractionDigits:2})}`);
  } else {
    console.log("No USD-quoted pools to aggregate USD price.");
  }
}
